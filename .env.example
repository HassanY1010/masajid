# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/masajid_db?schema=public"

# Application
NODE_ENV="development"
PORT=4000
API_PREFIX="api"
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# JWT Authentication
JWT_SECRET="masajid_super_secret_jwt_key_change_in_production_32char"
JWT_EXPIRATION="1h"
JWT_REFRESH_SECRET="masajid_refresh_token_super_secret_key_change_in_production"
JWT_REFRESH_EXPIRATION="7d"

# Storage Settings
STORAGE_DRIVER="local" # 'local' or 's3'
STORAGE_LOCAL_PATH="./uploads"
STORAGE_PUBLIC_URL="http://localhost:4000/uploads"

# S3 (optional if using cloud storage)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Initial Admin Seed
ADMIN_EMAIL="admin@masajid.app"
ADMIN_PASSWORD="AdminPassword123!"
ADMIN_NAME="مدير المنصة"
