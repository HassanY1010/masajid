datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProjectCategory {
  CONSTRUCTION
  RENOVATION
  MAINTENANCE
  SOLAR
  WATER
  ELECTRICITY
  CLEANING
  FURNISHING
  QURAN_SUPPLIES
  SOUND_SYSTEM
  AIR_CONDITIONING
  BATHROOMS
  LIGHTING
  INSULATION
  SECURITY
  MINARET
  DISABLED_ACCESS
  WOMEN_SECTION
  LIBRARY
  OTHER
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  FUNDING
  FULLY_FUNDED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ProjectImageType {
  COVER
  GALLERY
  BEFORE
  AFTER
}

enum ContributionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditAction {
  ADMIN_LOGIN
  ADMIN_LOGOUT
  ADMIN_CREATED_PROJECT
  ADMIN_UPDATED_PROJECT
  ADMIN_PUBLISHED_PROJECT
  ADMIN_UNPUBLISHED_PROJECT
  ADMIN_ARCHIVED_PROJECT
  ADMIN_DELETED_PROJECT
  ADMIN_APPROVED_CONTRIBUTION
  ADMIN_REJECTED_CONTRIBUTION
  ADMIN_CREATED_BANK_ACCOUNT
  ADMIN_UPDATED_BANK_ACCOUNT
  ADMIN_DELETED_BANK_ACCOUNT
  ADMIN_CREATED_UPDATE
}

model Admin {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("admins")
}

model Project {
  id              String           @id @default(uuid())
  title           String
  mosqueName      String
  governorate     String
  district        String
  locationText    String
  latitude        Float?
  longitude       Float?
  description     String           @db.Text
  needDescription String           @db.Text
  category        ProjectCategory  @default(MAINTENANCE)
  estimatedCost   Float
  currency        String           @default("SAR")
  totalShares     Int
  shareValue      Float
  fundedShares    Int              @default(0)
  fundedAmount    Float            @default(0.0)
  status          ProjectStatus    @default(DRAFT)
  isPublished     Boolean          @default(false)
  publishedAt     DateTime?
  images          ProjectImage[]
  updates         ProjectUpdate[]
  contributions   Contribution[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@index([isPublished])
  @@index([governorate])
  @@index([createdAt])
  @@map("projects")
}

model ProjectImage {
  id         String           @id @default(uuid())
  projectId  String
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url        String
  storageKey String
  type       ProjectImageType @default(GALLERY)
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())

  @@index([projectId])
  @@map("project_images")
}

model ProjectUpdate {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String   @db.Text
  images      String[] @default([])
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@map("project_updates")
}

model BankAccount {
  id            String   @id @default(uuid())
  name          String
  displayName   String
  accountName   String
  accountNumber String
  iban          String?
  currency      String   @default("SAR")
  logoUrl       String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("bank_accounts")
}

model Contribution {
  id                String             @id @default(uuid())
  projectId         String
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amount            Float
  currency          String             @default("SAR")
  shares            Int
  donorName         String?
  donorPhone        String?
  paymentMethod     String?
  receiptUrl        String?
  receiptStorageKey String?
  status            ContributionStatus @default(PENDING)
  rejectionReason   String?
  approvedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status])
  @@index([projectId])
  @@index([createdAt])
  @@map("contributions")
}

model AuditLog {
  id        String      @id @default(uuid())
  adminId   String?
  admin     Admin?      @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action    AuditAction
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([action])
  @@index([adminId])
  @@index([createdAt])
  @@map("audit_logs")
}
